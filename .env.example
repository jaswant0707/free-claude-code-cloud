# ==============================================================================
# Free Claude Code Cloud - Environment Configuration Template
# NOTE: Never commit sensitive keys or actual secrets to git!
# Configure these directly in your Vercel Project Settings or hosting dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Deployment & Authentication (CRITICAL FOR CLOUD ACCESS)
# ------------------------------------------------------------------------------
# Signals to Free Claude Code that it is running in a cloud/serverless environment
FCC_CLOUD_DEPLOYMENT=1

# Enables proxy bearer token authentication to protect your API from unauthorized traffic
PROXY_AUTH_ENABLED=true

# Secret token required for clients (Claude Code, Cursor, Cline, etc.) to access the proxy
# Use this in client configs as: Authorization: Bearer <your_token> or x-api-key: <your_token>
ANTHROPIC_AUTH_TOKEN=your-super-secret-proxy-token-here

# Secret token required to access the Web Admin UI (/admin) and Code Sessions (/admin/code)
# Can be provided via:
#   1. Header: Authorization: Bearer <token>
#   2. Cookie: fcc_admin_token
#   3. Query parameter: https://your-deployment.vercel.app/admin?token=<token>
ADMIN_AUTH_TOKEN=your-super-secret-admin-token-here

# ------------------------------------------------------------------------------
# 2. Storage & Operational Paths
# ------------------------------------------------------------------------------
# In serverless environments (Vercel, AWS Lambda), writeable storage must be in /tmp
FCC_CONFIG_DIR=/tmp/.fcc

# Server log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. Default Model Routing
# ------------------------------------------------------------------------------
# Format: provider_id/model/name
# Examples:
#   nvidia_nim/nvidia/nemotron-3-ultra-550b-a55b
#   openrouter/anthropic/claude-3.5-sonnet
#   groq/llama-3.3-70b-versatile
#   gemini/gemini-2.0-flash
MODEL=nvidia_nim/nvidia/nemotron-3-ultra-550b-a55b

# Specific model routes for Claude Code harness (optional, defaults to MODEL)
# MODEL_FABLE=
# MODEL_OPUS=
# MODEL_SONNET=
# MODEL_HAIKU=

# ------------------------------------------------------------------------------
# 4. AI Provider API Keys (Fill only the providers you use)
# ------------------------------------------------------------------------------
# NVIDIA NIM (Free tier available: build.nvidia.com)
NVIDIA_NIM_API_KEY=

# OpenRouter (openrouter.ai)
OPENROUTER_API_KEY=

# Groq (console.groq.com)
GROQ_API_KEY=

# Google Gemini (aistudio.google.com)
GEMINI_API_KEY=

# Together AI (api.together.xyz)
TOGETHER_API_KEY=

# DeepSeek (platform.deepseek.com)
DEEPSEEK_API_KEY=

# Cerebras (cloud.cerebras.ai)
CEREBRAS_API_KEY=

# OpenAI (platform.openai.com)
OPENAI_API_KEY=

# Mistral AI (console.mistral.ai)
MISTRAL_API_KEY=

# ------------------------------------------------------------------------------
# 5. Token Optimization (Optional)
# ------------------------------------------------------------------------------
# Enable RTK / Headroom token compression
# ENABLE_HEADROOM=false
# ENABLE_RTK=false
